[Unit]
Description=Hermes Harmony WebSocket relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/opt/hermes-harmony-relay/venv/bin/hermes-harmony-relay --host 127.0.0.1 --port 8765
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
